# ACE Cybersecurity Quiz — Environment Variables Template
# Copy this file to .env and fill in the values.
# NEVER commit the .env file to git.

# PostgreSQL connection string
# Format: postgresql+asyncpg://USER:PASSWORD@HOST:PORT/DBNAME
DATABASE_URL=postgresql+asyncpg://postgres:CHANGE_ME@localhost:5432/quizapp

# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=CHANGE_ME_GENERATE_WITH_PYTHON

# How long a login session lasts in minutes (quiz is 60 min, add buffer)
JWT_EXPIRE_MINUTES=100

# Password to log in to the admin dashboard
ADMIN_SECRET=CHANGE_ME_STRONG_PASSWORD

# Port the FastAPI server listens on
PORT=3000

# Quiz ID (leave as 1 unless running multiple quiz types)
QUIZ_ID=1

# Your Cloudflare Tunnel URL (fill this in after setting up the tunnel)
# Example: https://ace-quiz.cfargotunnel.com
TUNNEL_DOMAIN=https://CHANGE_ME.cfargotunnel.com

# Easter egg / recon honeypot flags
EASTER_EGG_SECRET=ACE{y0u_f0und_1t}
EASTER_EGG_FLAG=ACE{c4mpu5_3y35_4r3_4lw4y5_w4tch1ng}
